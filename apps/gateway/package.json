{
  "name": "@sistema-camaras/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "tsx --test src/security.test.ts src/infrastructure/media/ffmpeg-stream.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/security.test.ts src/infrastructure/media/ffmpeg-stream.test.ts",
    "test:integration": "tsx --test src/infrastructure/media/rtsp-camera.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@sistema-camaras/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
